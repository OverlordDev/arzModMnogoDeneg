rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Каждый (анонимный) пользователь читает и пишет ТОЛЬКО свой players/{uid}
    // и всё, что внутри него (history/...). Чужие данные недоступны.
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /players/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Всё остальное закрыто.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
